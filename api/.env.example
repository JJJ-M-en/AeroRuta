# Copia este archivo como ".env" y ajusta los valores según tu XAMPP.
# XAMPP por defecto: usuario root, sin contraseña, puerto 3306.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=aeroruta

PORT=3000

# Cambia esto por una cadena larga y aleatoria antes de publicar la API.
JWT_SECRET=cambia-este-secreto-en-produccion
